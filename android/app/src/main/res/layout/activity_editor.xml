<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/screen_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="22dp">
        <Button android:id="@+id/backButton" style="@style/TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Back" android:drawableStart="@drawable/ic_back"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end" android:text="YOUR WORKSPACE" style="@style/Eyebrow"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="22dp" android:paddingBottom="28dp" android:paddingTop="8dp">
            <TextView android:id="@+id/demoBanner" style="@style/DemoBanner" android:layout_marginBottom="14dp"/>
            <TextView android:id="@+id/editorHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="New application" style="@style/TitleText"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="A little organisation. A clearer next step." android:textColor="@color/muted" android:textSize="13sp" android:layout_marginTop="7dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:background="@drawable/card_bg" android:layout_marginTop="16dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="The opportunity" style="@style/SectionHeading" android:textSize="16sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Start with the essentials." android:textSize="12sp" android:textColor="@color/muted" android:layout_marginTop="4dp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Company *" style="@style/SmallLabel" android:layout_marginTop="18dp"/><EditText android:id="@+id/companyInput" style="@style/TrackerInput" android:hint="Company name" android:singleLine="true"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Role *" style="@style/SmallLabel" android:layout_marginTop="16dp"/><EditText android:id="@+id/roleInput" style="@style/TrackerInput" android:hint="e.g. Software Engineering Intern" android:singleLine="true"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Job listing URL" style="@style/SmallLabel" android:layout_marginTop="16dp"/><EditText android:id="@+id/jobUrlInput" style="@style/TrackerInput" android:hint="https://..." android:inputType="textUri" android:singleLine="true"/></LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:background="@drawable/card_bg" android:layout_marginTop="16dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Application details" style="@style/SectionHeading" android:textSize="16sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Track your progress and the CV you send." android:textSize="12sp" android:textColor="@color/muted" android:layout_marginTop="4dp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Status" style="@style/SmallLabel" android:layout_marginTop="18dp"/><Spinner android:id="@+id/statusInput" style="@style/TrackerSpinner"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Date applied" style="@style/SmallLabel" android:layout_marginTop="16dp" android:labelFor="@id/dateInput"/>
<Button android:id="@+id/dateInput" style="@style/TrackerInput" android:hint="Select date" android:singleLine="true" android:textAllCaps="false" android:gravity="start|center_vertical" android:freezesText="true" android:stateListAnimator="@null" android:drawableEnd="@drawable/ic_chevron_down" android:drawableTint="@color/primary" android:drawablePadding="8dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Submitted CV" style="@style/SmallLabel" android:layout_marginTop="16dp"/><Spinner android:id="@+id/cvInput" style="@style/TrackerSpinner"/></LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:background="@drawable/card_bg" android:layout_marginTop="16dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Prepare your next step" style="@style/SectionHeading" android:textSize="16sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Keep the role requirements and your notes together." android:textSize="12sp" android:textColor="@color/muted" android:layout_marginTop="4dp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Job description" style="@style/SmallLabel" android:layout_marginTop="18dp"/><EditText android:id="@+id/jobDescriptionInput" style="@style/TrackerInput" android:hint="Paste the requirements and responsibilities..." android:inputType="textMultiLine" android:minLines="4" android:gravity="top"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your notes" style="@style/SmallLabel" android:layout_marginTop="16dp"/><EditText android:id="@+id/notesInput" style="@style/TrackerInput" android:hint="Contacts, follow-ups or interview notes..." android:inputType="textMultiLine" android:minLines="3" android:gravity="top"/></LinearLayout>
            <Button android:id="@+id/saveButton" style="@style/PrimaryButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="22dp" android:text="Save application"/>
            <Button android:id="@+id/tailorButton" style="@style/SecondaryButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="Tailor CV with AI" android:drawableStart="@drawable/ic_document"/>
            <Button android:id="@+id/deleteButton" style="@style/TextButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:text="Delete application" android:textColor="@color/status_rejected"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
