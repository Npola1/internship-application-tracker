<resources>
    <style name="TrackerTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:colorControlActivated">@color/primary</item>
        <item name="android:statusBarColor">@color/background_top</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/background_bottom</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@drawable/screen_background</item>
    </style>
    <style name="TitleText">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">27sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Eyebrow">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.12</item>
    </style>
    <style name="SmallLabel">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="SectionHeading">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="ActionButton">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="PrimaryButton" parent="ActionButton">
        <item name="android:background">@drawable/primary_button</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:drawableTint">@color/white</item>
    </style>
    <style name="SecondaryButton" parent="ActionButton">
        <item name="android:background">@drawable/secondary_button</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:drawableTint">@color/primary</item>
    </style>
    <style name="TextButton" parent="ActionButton">
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:drawableTint">@color/primary</item>
        <item name="android:paddingHorizontal">8dp</item>
    </style>
    <style name="NavButton" parent="TextButton">
        <item name="android:textColor">@color/muted</item>
        <item name="android:drawableTint">@color/muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:paddingVertical">6dp</item>
    </style>
    <style name="DemoBanner">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/demo_badge</item>
        <item name="android:text">Offline demo · Saved on this phone</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:visibility">gone</item>
    </style>
    <style name="TrackerInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:padding">13dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:background">@drawable/input_bg</item>
    </style>
    <style name="TrackerSpinner">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">36dp</item>
        <item name="android:background">@drawable/spinner_bg</item>
        <item name="android:popupBackground">@color/white</item>
    </style>
</resources>
